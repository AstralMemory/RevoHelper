                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            IsEnabled="{Binding CanUseCustomMode}" ToolTipService.ShowOnDisabled="True"
                                            Margin="0,0,5,8" ToolTip="{Binding UiCopy.CustomPlanHint}">
