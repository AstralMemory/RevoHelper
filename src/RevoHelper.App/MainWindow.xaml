                                        <Viewbox Width="13" Height="13"><Canvas Width="16" Height="16">
                                            <Path Data="M1.5,2.5 H14.5 V11.5 H1.5 Z M5,14 H11 M8,11.5 V14"
                                                  Stroke="#2185F4" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                        </Canvas></Viewbox>
                                    </Border>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="GpuOutputQuickTitle" Text="{Binding UiCopy.GpuOutputTitle}" Foreground="{DynamicResource TextBrush}"
