                                    <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource DisplayTabRadioStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SupportsDisplayRefreshRate}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                                </RadioButton>
                            </UniformGrid>

                            <Border presentation:ThemeScope.AccentSurface="True" Margin="0,8,0,10" Padding="11,9" Background="#F2EFFF"
                                    BorderBrush="#B9A8FF" BorderThickness="1" CornerRadius="10">
                                <TextBlock Text="{presentation:UiText Value={Binding DisplayColorStatusText}}" Foreground="#5647BA" FontSize="{presentation:UiFont 8.3}"
                                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                            </Border>

                            <StackPanel x:Name="DisplayColorCalibrationPage">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDisplayColorCalibrationPage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Padding="13,11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{presentation:UiText '色彩管理'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11}" FontWeight="SemiBold" />
                                            <TextBlock Text="{presentation:UiText '选择机械革命显示色彩预设'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.1}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsDisplayColorManagementEnabled, Mode=OneWay}"
                                                  IsEnabled="{Binding SupportsDisplayColorManagement}"
                                                  Click="DisplayColorManagement_Click" Style="{StaticResource SettingsToggleStyle}" />
                                    </Grid>
                                </Border>

                                <Border x:Name="DisplayColorArtwork" Height="116" Margin="0,10,0,0" CornerRadius="12"
                                        BorderBrush="{DynamicResource NeutralC7D7E8Brush}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#16BE9D" Offset="0" />
                                                <GradientStop Color="#2AC4D5" Offset="0.28" />
                                                <GradientStop Color="#F3DB67" Offset="0.60" />
                                                <GradientStop Color="#FF956A" Offset="0.82" />
                                                <GradientStop Color="#F45379" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <Border Opacity="0.34">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#41E0C6" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="0.42" />
                                                    <GradientStop Color="#50FFFFFF" Offset="0.66" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="COLOR" Foreground="White" FontSize="{presentation:UiFont 25}" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="{presentation:UiText '校色模式'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 10.5}"
                                           FontWeight="SemiBold" Margin="1,12,0,5" />
                                <UniformGrid Columns="2" IsEnabled="{Binding IsDisplayColorManagementEnabled}">
                                    <RadioButton Tag="0" Content="Default" GroupName="DisplayColorMode" Click="DisplayColor_Click"
                                                 IsChecked="{Binding IsDisplayColorDefault, Mode=OneWay}" Style="{StaticResource DisplayColorPresetRadioStyle}" />
                                    <RadioButton Tag="1" Content="sRGB" GroupName="DisplayColorMode" Click="DisplayColor_Click"
                                                 IsChecked="{Binding IsDisplayColorSrgb, Mode=OneWay}" Style="{StaticResource DisplayColorPresetRadioStyle}" />
                                    <RadioButton Tag="2" Content="P3" GroupName="DisplayColorMode" Click="DisplayColor_Click"
                                                 IsChecked="{Binding IsDisplayColorP3, Mode=OneWay}" Style="{StaticResource DisplayColorPresetRadioStyle}" />
                                    <RadioButton Tag="3" Content="AdobeRGB" GroupName="DisplayColorMode" Click="DisplayColor_Click"
                                                 IsChecked="{Binding IsDisplayColorAdobeRgb, Mode=OneWay}" Style="{StaticResource DisplayColorPresetRadioStyle}" />
                                </UniformGrid>
                                <TextBlock Text="{presentation:UiText 'Default 保持系统和显示器当前的默认色彩行为。'}"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.1}" Margin="4,8,4,0"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="DisplayFeaturePage">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDisplayFeaturePage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Padding="13,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{presentation:UiText 'Mini LED 局部调光'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11}" FontWeight="SemiBold" />
                                            <TextBlock Text="{presentation:UiText '此设备未声明支持时不可用'}" Foreground="#A47A22" FontSize="{presentation:UiFont 7.8}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsMiniLedLocalDimmingEnabled, Mode=OneWay}"
                                                  IsEnabled="{Binding SupportsMiniLedLocalDimming}"
                                                  Click="MiniLedLocalDimming_Click" Style="{StaticResource SettingsToggleStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="DisplayRefreshRatePage">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDisplayRefreshRatePage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Padding="13,11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{presentation:UiText '自动刷新率'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11}" FontWeight="SemiBold" />
                                            <TextBlock Text="{presentation:UiText 'DC 使用最低刷新率，AC 恢复偏好刷新率'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.1}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsAutomaticRefreshRateEnabled, Mode=OneWay}"
                                                  Click="AutomaticRefreshRate_Click" Style="{StaticResource SettingsToggleStyle}" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,10,0,0" Padding="13,11" Background="{DynamicResource NeutralF8FAFDBrush}"
                                        BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{presentation:UiText '当前显示器'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 10.5}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 7.8}" Margin="0,2,0,0" />
                                            <TextBlock Text="{presentation:UiText Value={Binding DisplayResolutionText}}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.2}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{presentation:UiText Value={Binding CurrentDisplayRefreshRateText}}" Foreground="#6252DE"
                                                   FontSize="{presentation:UiFont 20}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="{presentation:UiText '选择刷新率 (Hz)'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 10.2}"
                                           FontWeight="SemiBold" Margin="1,13,0,6" />
                                <ComboBox x:Name="DisplayRefreshRateSelector" Height="34"
                                          ItemsSource="{Binding DisplayRefreshRates}"
                                          SelectedItem="{Binding SelectedDisplayRefreshRateHz, Mode=OneWay}"
                                          SelectionChanged="DisplayRefreshRate_SelectionChanged"
                                          ItemStringFormat="{}{0} Hz"
                                          Style="{StaticResource ModernComboBoxStyle}" />
                                <Button Content="{presentation:UiText '应用并保存'}" Height="32" Margin="0,8,0,0" FontSize="{presentation:UiFont 9}"
                                        ToolTip="{presentation:UiText '保存为 Windows 默认刷新率，重启后仍生效。自动省电切换不会更改此默认值。'}"
                                        IsEnabled="{Binding CanApplyDisplayRefreshRate}"
                                        Click="ApplyDisplayRefreshRate_Click" Style="{StaticResource IconButtonStyle}" />
                                <TextBlock Text="{presentation:UiText '切换显卡输出后，重新打开本页刷新可用刷新率。'}"
                                           ToolTip="{presentation:UiText '刷新率由 Windows 当前显示路径实时枚举。'}"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8}" Margin="4,8,4,0"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="FanDrawerContent" Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock x:Name="FanCurveModeHeading" Text="{presentation:UiText Value={Binding FanCurveModeHeading}}"
                                       ToolTip="{presentation:UiText '官方预设仅供参考，自定义模式可以调整。'}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 9.5}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,10,0,0" Padding="10,8" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="{presentation:UiText Value={Binding FanStatusText}}" Foreground="{DynamicResource TextBrush}"
                                               FontSize="{presentation:UiFont 9.5}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="FanCurveTemperatureHint" Text="{presentation:UiText Value={Binding FanCurveLimitText}}"
                                               Visibility="{Binding IsCustomProfileSelected, Converter={StaticResource ModeVisibilityConverter}}"
                                               Foreground="{DynamicResource GreenBrush}" FontSize="{presentation:UiFont 8.4}" Margin="0,3,0,0" />
                                    <TextBlock x:Name="FanEditingAvailabilityText"
                                               Text="{presentation:UiText Value={Binding FanEditingAvailabilityText}}"
                                               Foreground="#B36B00" FontSize="{presentation:UiFont 8.4}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="FanResponseControls" Margin="2,9,2,0" Padding="9,7"
                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="9"
                                    Opacity="{Binding FanCurveSurfaceOpacity}"
                                    IsEnabled="{Binding CanEditFanSettings}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FanIndependentOutputLabel" Grid.Row="0" Text="{presentation:UiText '启用风扇独立输出'}"
                                               Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 9.2}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <CheckBox x:Name="FanIndependentOutputToggle" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                               IsChecked="{Binding IsFanIndependentOutputEnabled, Mode=TwoWay}"
                                               Style="{StaticResource SettingsToggleStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Click="FanResponseToggle_Click" />
                                    <TextBlock x:Name="FanTransitionSensitivityLabel" Grid.Row="1" Text="{presentation:UiText '启用风扇转换延迟'}"
                                               Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 9.2}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,7,0,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="FanTransitionSensitivityToggle" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               IsChecked="{Binding IsFanTransitionSensitivityEnabled, Mode=TwoWay}"
                                               Style="{StaticResource SettingsToggleStyle}"
                                               Margin="0,7,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Click="FanResponseToggle_Click" />
                                    <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{presentation:UiText '转换延迟'}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="{presentation:UiFont 8.8}" VerticalAlignment="Center" />
                                        <Slider x:Name="FanTransitionSensitivitySlider" Grid.Column="1"
                                                 Height="18" Margin="8,0,8,0" Minimum="0" Maximum="5000"
                                                 TickFrequency="100" SmallChange="100" LargeChange="100" IsSnapToTickEnabled="True"
                                                 Value="{Binding FanTransitionSensitivity, Mode=TwoWay}"
                                                 IsEnabled="{Binding IsFanTransitionSensitivityEnabled}"
                                                 ValueChanged="FanResponseSlider_ValueChanged"
                                                 ToolTip="{presentation:UiText '每 0.5% 转速变化的延迟，范围 0–5000 ms，步长 100 ms。'}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FanTransitionSensitivityValue" Grid.Column="2"
                                                    Text="{presentation:UiText Value={Binding FanTransitionSensitivityText}}" Foreground="{DynamicResource MutedBrush}"
                                                    FontSize="{presentation:UiFont 8.2}" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Margin="0,9,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton presentation:ThemeScope.AccentSurface="True" x:Name="CpuFanRadio" Grid.Column="0" GroupName="FanChannel"
                                             Content="{presentation:UiText 'CPU 风扇'}" IsChecked="{Binding IsShowingCpuFan, Mode=OneWay}"
                                             Background="{Binding FanAccentSurfaceColor}"
                                             BorderBrush="{Binding FanAccentColor}"
                                             Style="{StaticResource FanChannelRadioStyle}" Checked="CpuFan_Checked" />
                                <RadioButton presentation:ThemeScope.AccentSurface="True" x:Name="GpuFanRadio" Grid.Column="1" GroupName="FanChannel" Content="{presentation:UiText 'GPU 风扇'}"
                                             IsChecked="{Binding IsShowingGpuFan, Mode=OneWay}"
                                             Background="{Binding FanAccentSurfaceColor}"
                                             BorderBrush="{Binding FanAccentColor}"
                                             Style="{StaticResource FanChannelRadioStyle}" Checked="GpuFan_Checked" />
                            </Grid>

                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.6}" Margin="2,1,0,5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{presentation:UiText '拖动图中点位，或在下方输入转速比例'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomProfileSelected}" Value="False">
                                                <Setter Property="Text" Value="{presentation:UiText '切换到自定义模式后可调整风扇。'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border presentation:ThemeScope.AccentSurface="True" x:Name="FanCurveChartSurface" Height="176" Background="{Binding FanAccentSurfaceColor}"
                                    Opacity="{Binding FanCurveSurfaceOpacity}" CornerRadius="10"
                                    IsEnabled="{Binding CanEditFanSettings}"
                                    PreviewMouseLeftButtonUp="FanCurveEditor_Commit">
                                <controls:FanCurveChart x:Name="FanCurveChart"
                                                        ItemsSource="{Binding FanPoints}"
                                                        AccentBrush="{Binding FanAccentColor}" />
                            </Border>

                            <ItemsControl x:Name="FanPointEditors" ItemsSource="{Binding FanPoints}"
                                          Opacity="{Binding FanCurveSurfaceOpacity}"
                                          IsEnabled="{Binding CanEditFanSettings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="1.5" Padding="3,2" Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource NeutralDFE5EEBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="31" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{presentation:UiText Value={Binding TemperatureLabel}}" FontSize="{presentation:UiFont 9.5}"
                                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding DutyPercent, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBoxStyle}"
                                                         Height="20" Padding="2,0" FontSize="{presentation:UiFont 9.5}" TextAlignment="Right"
                                                         VerticalContentAlignment="Center" BorderBrush="{DynamicResource NeutralC8D2DFBrush}"
                                                         LostKeyboardFocus="FanPointEditor_LostKeyboardFocus"
                                                         KeyDown="FanPointEditor_KeyDown" />
                                                <TextBlock Grid.Column="2" Text="%" FontSize="{presentation:UiFont 8}" Margin="1,0,0,0"
                                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="RestoreOemFanCurveButton"
                                    Content="{presentation:UiText '恢复该档位原厂默认曲线'}" Height="29" Margin="2,8,2,0" FontSize="{presentation:UiFont 8.4}"
                                    IsEnabled="{Binding CanEditFanSettings}"
                                    Style="{StaticResource IconButtonStyle}" Click="RestoreOemFanCurve_Click" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="OtherDrawerContent" Grid.Row="2" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,8">
                        <StackPanel Margin="1,0,1,5">
                            <TextBlock Text="{presentation:UiText '系统工具'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 9.3}" FontWeight="SemiBold" Margin="2,1,0,7" />
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="12" Padding="13">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{presentation:UiText '定时关机'}" FontSize="{presentation:UiFont 10.5}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{presentation:UiText '使用 Windows 原生关机提醒'}" FontSize="{presentation:UiFont 8}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,8,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="ShutdownMinuteSelector" Grid.Column="1" Height="30"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  ItemsSource="{Binding ShutdownMinuteOptions}" SelectedItem="{Binding SelectedShutdownMinutes, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{presentation:UiText Value={Binding StringFormat={}{0} min}}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Border presentation:ThemeScope.AccentSurface="True" Margin="0,12,0,0" Padding="12,9" CornerRadius="10" Background="#F1F7FF" BorderBrush="#A9CEF6" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{presentation:UiText '剩余时间'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 7.8}" />
                                                <TextBlock x:Name="ShutdownCountdownText" Text="{presentation:UiText Value={Binding ShutdownCountdownText}}" Foreground="#176FC1" FontWeight="SemiBold" Margin="0,2,0,0" Language="zh-CN">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="{presentation:UiFont 16}" />
                                                            <Setter Property="FontFamily" Value="Consolas" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsShutdownScheduled}" Value="False">
                                                                    <Setter Property="FontSize" Value="{presentation:UiFont 13}" />
                                                                    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{presentation:UiText '预计关机'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 7.8}" TextAlignment="Right" />
                                                <TextBlock Text="{presentation:UiText Value={Binding ShutdownDueTimeText}}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 9.5}" FontWeight="SemiBold" TextAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{presentation:UiText Value={Binding ShutdownStatusText}}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.3}" TextWrapping="Wrap" Margin="1,8,1,0" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button x:Name="ScheduleShutdownButton" Content="{presentation:UiText '开始倒计时'}" Height="32" FontSize="{presentation:UiFont 9}" Margin="0,0,4,0" IsEnabled="{Binding CanScheduleShutdown}" Style="{StaticResource IconButtonStyle}" Click="ScheduleShutdown_Click" />
                                        <Button x:Name="CancelShutdownButton" Grid.Column="1" Content="{presentation:UiText '取消关机'}" Height="32" FontSize="{presentation:UiFont 9}" Margin="4,0,0,0" IsEnabled="{Binding CanCancelShutdown}" Style="{StaticResource IconButtonStyle}" Click="CancelShutdown_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border presentation:ThemeScope.AccentSurface="True" Background="#F6F3FF" BorderBrush="#C9BAFF" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{presentation:UiText '强冷'}" FontSize="{presentation:UiFont 10.5}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{presentation:UiText '临时将笔记本风扇拉至最大转速'}" FontSize="{presentation:UiFont 8}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                                        <TextBlock Text="{presentation:UiText Value={Binding FanBoostStatusText}}" FontSize="{presentation:UiFont 8.3}" Foreground="#6D43B7" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <TextBlock Text="{presentation:UiText '风扇会明显变响，关闭后恢复原档位。'}" FontSize="{presentation:UiFont 8}" Foreground="#D9363E" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="FanBoostToggle" Grid.Column="1" IsChecked="{Binding IsFanBoostEnabled, Mode=OneWay}"
                                              IsEnabled="{Binding CanToggleFanBoost}" Click="FanBoost_Click" Style="{StaticResource SettingsToggleStyle}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="MoreProfilesDrawerContent" Grid.Row="2" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,8">
                        <StackPanel Margin="1,0,1,5">
                            <Border presentation:ThemeScope.AccentSurface="True" Background="#F1F7FF" BorderBrush="#90BFF2" BorderThickness="1" CornerRadius="12" Padding="13">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{presentation:UiText '动态节能'}" FontSize="{presentation:UiFont 12}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <Border x:Name="DynamicPowerHelpIcon" Width="14" Height="14" CornerRadius="7" Margin="6,0,0,0"
                                                    Background="Transparent" BorderBrush="#718095" BorderThickness="0.8" Cursor="Help" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{presentation:UiText '动态节能说明'}">
                                                <Border.ToolTip>
                                                    <ToolTip x:Name="DynamicPowerHelpTooltip" presentation:ThemeScope.AccentSurface="True"
                                                             Background="#F1F7FF" BorderBrush="#90BFF2" Foreground="{DynamicResource TextBrush}"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <StackPanel MaxWidth="290">
                                                            <TextBlock Text="{presentation:UiText '动态节能说明'}" FontSize="{presentation:UiFont 9.5}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                            <TextBlock Text="{presentation:UiText '默认关闭 · 适用于所有性能档位'}" FontSize="{presentation:UiFont 8.5}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{presentation:UiText Value={Binding Experiments.DynamicProgress}}" FontSize="{presentation:UiFont 8.5}"
                                                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,6" />
                                                            <TextBlock x:Name="DynamicPowerRulesText" FontSize="{presentation:UiFont 9}" TextWrapping="Wrap"
                                                                       Text="{presentation:UiText '空闲时临时限频，忙碌或切换档位即恢复；不改原设置。'}" />
                                                            <TextBlock x:Name="DynamicPowerDelayWarning" Text="{presentation:UiText '负载升高会恢复原限制；Windows 频率响应可能延迟 5–10 秒。'}"
                                                                       Foreground="#D9363E" FontSize="{presentation:UiFont 8.5}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <TextBlock Text="?" Foreground="#718095" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <CheckBox x:Name="DynamicPowerToggle" Grid.Column="1" IsChecked="{Binding Experiments.IsDynamicEnabled, Mode=OneWay}"
                                                  IsEnabled="{Binding Experiments.CanToggleDynamic}" Click="DynamicPower_Click" Style="{StaticResource SettingsToggleStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="DynamicPowerMechanismText" Text="{presentation:UiText '最近 10 分钟至少 90% 空闲时，临时限制至 3 GHz'}" FontSize="{presentation:UiFont 9}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DynamicPowerBenefitText" Text="{presentation:UiText '可同时降低 CPU 功耗和温度'}" FontSize="{presentation:UiFont 9}" Foreground="#246292" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DynamicPowerStatus" Text="{presentation:UiText Value={Binding Experiments.DynamicMessage}}" FontSize="{presentation:UiFont 9}" Foreground="#246292" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <Button x:Name="DynamicRecoverButton" Content="{presentation:UiText '暂停并恢复原限制'}" Height="32" Margin="0,12,0,0" FontSize="{presentation:UiFont 9}"
                                            IsEnabled="{Binding Experiments.CanToggleDynamic}" Style="{StaticResource IconButtonStyle}" Click="DynamicRecover_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="SettingsDrawerContent" Grid.Row="2" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding UiCopy.StartupSectionTitle}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 10}"
                                       FontWeight="SemiBold" Margin="0,2,0,7" />
                            <Border Padding="13,11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}"
                                    BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding UiCopy.StartWithWindowsTitle}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11.5}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UiCopy.StartWithWindowsDescription}" Foreground="{DynamicResource MutedBrush}"
                                                   ToolTip="{presentation:UiText '设置后会回读确认系统启动项。'}"
                                                   FontSize="{presentation:UiFont 8.8}" Margin="0,3,8,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                              Style="{StaticResource SettingsToggleStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding UiCopy.WindowSectionTitle}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 10}"
                                       FontWeight="SemiBold" Margin="0,16,0,7" />
                            <Border Padding="13,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}"
                                    BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <Grid Margin="0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{Binding UiCopy.WindowScaleTitle}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11.5}" FontWeight="SemiBold" />
                                            <TextBlock x:Name="WindowScaleHint" Text="{Binding UiCopy.WindowScaleDescription}"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.2}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="WindowScaleSelector" Grid.Column="1" Height="30" VerticalAlignment="Center"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  ItemsSource="{Binding WindowScaleOptions}" SelectedItem="{Binding WindowScalePercent, Mode=OneWay}"
                                                  SelectionChanged="WindowScale_SelectionChanged" AutomationProperties.Name="{presentation:UiText '窗口缩放'}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{presentation:UiText Value={Binding StringFormat={}{0}%}}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource NeutralE3E8F0Brush}" />
                                    <Grid Margin="0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding UiCopy.AlwaysOnTopTitle}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11.5}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding UiCopy.AlwaysOnTopDescription}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.8}" Margin="0,3,8,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                                                  Style="{StaticResource SettingsToggleStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource NeutralE3E8F0Brush}" />
                                    <Grid Margin="0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding UiCopy.RememberWindowPositionTitle}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11.5}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding UiCopy.RememberWindowPositionDescription}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.8}" Margin="0,3,8,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding RememberWindowPosition, Mode=TwoWay}"
                                                  Style="{StaticResource SettingsToggleStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{presentation:UiText '可能冲突服务检测'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 10}"
                                       FontWeight="SemiBold" Margin="0,16,0,7" />
                            <Border Padding="13,11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}"
                                    BorderThickness="1" CornerRadius="12">
                                <StackPanel x:Name="ConflictServicesPanel">
                                    <Border presentation:ThemeScope.AccentSurface="True" x:Name="OfficialConsoleConflictCard" Padding="10,8" Margin="0,0,0,10"
                                            Background="#F6F3FF" BorderBrush="#C9BAFF" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{presentation:UiText '机械革命官方控制台（CCUWinUI）'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 9.5}" FontWeight="SemiBold" />
                                                <TextBlock Text="{presentation:UiText 'RevoHelper 可以与官方控制台共存。请保留 GCUBridge、GCUService 和 OSD 热键后台运行。'}"
                                                           Foreground="#6652B8" FontSize="{presentation:UiFont 8.2}" Margin="0,3,8,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border presentation:ThemeScope.AccentSurface="True" Grid.Column="1" Padding="7,3" CornerRadius="7" VerticalAlignment="Center" Background="#EEE9FF">
                                                <TextBlock Text="{presentation:UiText Value={Binding OfficialConsoleStatusText}}" Foreground="#6B4FD3" FontSize="{presentation:UiFont 8}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{presentation:UiText 'Intel 平台服务（可选测试）'}"
                                               Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11.5}" FontWeight="SemiBold" />
                                    <TextBlock Text="{presentation:UiText '可能改写功耗策略；可临时停止或恢复，不会修改开机启动类型。'}"
                                               ToolTip="{presentation:UiText 'XtuService、dptftcs 与 ipfsvc 属于 Intel 平台服务，不是机械革命控制台。'}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.8}"
                                               Margin="0,3,0,8" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="ConflictServicesList" ItemsSource="{Binding ConflictServices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="{presentation:UiFont 9.5}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ServiceName}" Foreground="{DynamicResource MutedBrush}"
                                                                   FontSize="{presentation:UiFont 7.8}" Margin="0,1,8,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Padding="7,3" CornerRadius="7" VerticalAlignment="Center"
                                                            Background="{DynamicResource NeutralEFF3F8Brush}">
                                                        <TextBlock Text="{presentation:UiText Value={Binding StatusText}}" FontSize="{presentation:UiFont 8}" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Neutral738095Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Foreground" Value="#139A55" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="StopConflictServicesButton" Grid.Column="0"
                                                Content="{presentation:UiText '停止所选服务'}" Height="29" Margin="0,0,3,0" FontSize="{presentation:UiFont 8.6}"
                                                IsEnabled="{Binding CanStopSelectedConflictServices}"
                                                Click="StopSelectedConflictServices_Click"
                                                Style="{StaticResource IconButtonStyle}" />
                                        <Button x:Name="RestoreConflictServicesButton" Grid.Column="1"
                                                Content="{presentation:UiText '恢复所选服务'}" Height="29" Margin="3,0,0,0" FontSize="{presentation:UiFont 8.6}"
                                                IsEnabled="{Binding CanRestoreSelectedConflictServices}"
                                                Click="RestoreSelectedConflictServices_Click"
                                                Style="{StaticResource IconButtonStyle}" />
                                    </Grid>
                                    <TextBlock Text="{presentation:UiText Value={Binding ConflictServiceOperationStatusText}}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.2}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{presentation:UiText '设备与功能检测'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 10}"
                                       FontWeight="SemiBold" Margin="0,16,0,7" />
                            <Border x:Name="CapabilityDetectionSection" Padding="13,11" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{presentation:UiText '设备与功能状态'}" Foreground="{DynamicResource TextBrush}"
                                                   FontSize="{presentation:UiFont 11.5}" FontWeight="SemiBold" />
                                        <TextBlock Text="{presentation:UiText Value={Binding PlatformModeAvailabilityReason}}"
                                                   ToolTip="{presentation:UiText Value={Binding PlatformModeAvailabilityReason}}"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.8}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="CapabilityRecheckButton" Grid.Column="1"
                                            Content="{presentation:UiText Value={Binding CapabilityRecheckLabel}}"
                                            IsEnabled="{Binding CanRecheckCapabilities}" Click="CapabilityRecheck_Click"
                                            Height="30" Padding="14,5" MinWidth="82" VerticalAlignment="Center"
                                            Background="#EAF4FF" BorderBrush="#B9D5F2" Foreground="#2676B8"
                                            FontWeight="SemiBold" Style="{StaticResource IconButtonStyle}" FontSize="{presentation:UiFont 8.8}"
                                            ToolTip="{presentation:UiText Value={Binding PlatformModeAvailabilityReason}}"
                                            ToolTipService.ShowOnDisabled="True" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding UiCopy.InterfaceSectionTitle}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 10}"
                                       FontWeight="SemiBold" Margin="0,16,0,7" />
                            <Border Padding="13,11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}"
                                    BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="126" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding UiCopy.LanguageTitle}" Foreground="{DynamicResource TextBrush}"
                                               FontSize="{presentation:UiFont 11.5}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox x:Name="UiLanguageSelector" Grid.Column="1" Height="30"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              ItemsSource="{Binding UiLanguageOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Code"
                                              SelectedValue="{Binding SelectedUiLanguageCode, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border Padding="13,11" Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="126" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{presentation:UiText '外观'}" Foreground="{DynamicResource TextBrush}"
                                               FontSize="{presentation:UiFont 11.5}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox x:Name="UiThemeSelector" Grid.Column="1" Height="30"
                                              Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding UiThemeOptions}"
                                              SelectedValuePath="Code" SelectedValue="{Binding SelectedUiThemeCode, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate><DataTemplate>
                                            <TextBlock Text="{presentation:UiText Value={Binding Label}}" />
                                        </DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Button x:Name="AnnouncementsEntryButton" Click="Announcements_Click" Margin="0,12,0,0"
                                    Style="{StaticResource IconButtonStyle}" Height="38" HorizontalContentAlignment="Stretch">
                                <Grid Width="272">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AnnouncementsEntryTitle" Text="{Binding Announcements.Title}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11.5}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    <TextBlock x:Name="AnnouncementsEntryDescription" Grid.Column="1" Text="{Binding Announcements.EntryDescription}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.8}" TextWrapping="NoWrap" Margin="10,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource MutedBrush}" FontSize="18" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="SettingsVersionFooter" Grid.Row="3" Visibility="Collapsed" Text="{presentation:UiText Value={Binding AppVersionText}}"
                               Foreground="{DynamicResource NeutralAAB4C2Brush}" FontSize="{presentation:UiFont 9}" HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" Margin="0,6,10,3" />
                </Grid>
            </Border>
        </Grid>
    </Border>
    </Viewbox>
</Window>
