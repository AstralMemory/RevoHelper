                                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,7,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="328" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="HomeTitle" Text="{Binding UiCopy.HomeTitle}" Foreground="{DynamicResource TextBrush}"
                                   FontSize="{presentation:UiFont 18}" FontWeight="SemiBold" Margin="0,0,0,1" />
                        <Grid Height="116" Margin="-4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="58" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton presentation:ThemeScope.AccentSurface="True" x:Name="OfficeProfileRadio" Grid.Row="0" Grid.Column="0" GroupName="PerformanceProfile"
                                         Content="{presentation:UiText Value={Binding OfficeModeTitle}}" Tag="office" ToolTip="{presentation:UiText Value={Binding OfficeModeTooltip}}"
                                         AutomationProperties.HelpText="{presentation:UiText Value={Binding OfficeModeDescription}}"
                                         Grid.RowSpan="{Binding PresetRowSpan}" Visibility="{Binding ShowOfficeMode, Converter={StaticResource ModeVisibilityConverter}}"
                                         IsEnabled="{Binding CanUseOfficeMode}"
                                         Background="#DDF8E8" Style="{StaticResource ProfileRadioStyle}"
                                         Checked="Profile_Checked" />
                            <RadioButton presentation:ThemeScope.AccentSurface="True" x:Name="BalancedProfileRadio" Grid.Row="0" Grid.Column="1" GroupName="PerformanceProfile"
                                         Content="{presentation:UiText Value={Binding BalancedModeTitle}}" Tag="balanced" ToolTip="{presentation:UiText Value={Binding BalancedModeTooltip}}"
                                         AutomationProperties.HelpText="{presentation:UiText Value={Binding BalancedModeDescription}}"
                                         Grid.RowSpan="{Binding PresetRowSpan}" Visibility="{Binding ShowBalancedMode, Converter={StaticResource ModeVisibilityConverter}}"
                                         IsEnabled="{Binding CanUseBalancedMode}"
                                         Background="#DCEEFF" Style="{StaticResource ProfileRadioStyle}"
                                         Checked="Profile_Checked" />
                            <Grid Grid.Row="1" Grid.Column="0" Visibility="{Binding ShowTurboMode, Converter={StaticResource ModeVisibilityConverter}}">
                                <RadioButton presentation:ThemeScope.AccentSurface="True" x:Name="TurboProfileRadio" GroupName="PerformanceProfile"
                                             Content="{Binding UiCopy.TurboTitle}" Tag="turbo" ToolTip="{presentation:UiText Value={Binding TurboModeTooltip}}"
                                             AutomationProperties.HelpText="{Binding TurboModeDescription}"
                                             IsEnabled="{Binding CanUseTurboQuietMode}"
                                             Background="#EEDCFF" Style="{StaticResource ProfileRadioStyle}"
                                             Checked="Profile_Checked" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" Margin="0,0,9,8"
                                            Visibility="{Binding ShowTurboStrategies, Converter={StaticResource ModeVisibilityConverter}}">
                                    <RadioButton x:Name="TurboQuietRadio" GroupName="TurboStrategy" Content="{Binding UiCopy.QuietTitle}" Tag="quiet"
                                                 IsChecked="True" Style="{StaticResource StrategyRadioStyle}"
                                                 IsEnabled="{Binding CanUseTurboQuietMode}"
                                                 Checked="TurboStrategy_Checked" />
                                    <RadioButton x:Name="TurboHighRadio" GroupName="TurboStrategy" Content="{Binding UiCopy.HighPerformanceTitle}" Tag="high"
                                                 IsEnabled="{Binding CanUseTurboHighMode}"
                                                 Style="{StaticResource StrategyRadioStyle}"
                                                 Checked="TurboStrategy_Checked" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1" Visibility="{Binding ShowCustomMode, Converter={StaticResource ModeVisibilityConverter}}">
                                <RadioButton presentation:ThemeScope.AccentSurface="True" x:Name="CustomProfileRadio" GroupName="PerformanceProfile"
