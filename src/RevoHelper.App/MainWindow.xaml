                                    </StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DataContext.UiCopy.PowerUsageLabel, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.5}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="PowerValue" Text="{presentation:UiText Value={Binding Power}}"
                                                   Foreground="{DynamicResource CpuBrush}" FontSize="{presentation:UiFont 11}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DataContext.UiCopy.FrequencyLabel, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.5}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="FrequencyValue" Text="{presentation:UiText Value={Binding Frequency}}"
                                                   Foreground="{DynamicResource CpuFrequencyBrush}" FontSize="{presentation:UiFont 9.5}" FontWeight="SemiBold"
                                                   TextAlignment="Center" LineHeight="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:DeviceKind.Cpu}">
                                    <Setter TargetName="DeviceLabel" Property="Text" Value="CPU" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:DeviceKind.IntegratedGpu}">
                                    <Setter TargetName="DeviceBadge" Property="Background" Value="#FFF1C9" />
                                    <Setter TargetName="DeviceLabel" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="GpuKindLabel" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="GpuKindLabel" Property="Text" Value="{presentation:UiText '集成'}" />
                                    <Setter TargetName="UsageValue" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="TemperatureValue" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="PowerValue" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="FrequencyValue" Property="Foreground" Value="{DynamicResource GpuFrequencyBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:DeviceKind.DiscreteGpu}">
                                    <Setter TargetName="DeviceBadge" Property="Background" Value="#FFE5C6" />
                                    <Setter TargetName="DeviceLabel" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="GpuKindLabel" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="GpuKindLabel" Property="Text" Value="{presentation:UiText '独立'}" />
                                    <Setter TargetName="UsageValue" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="TemperatureValue" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="PowerValue" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="FrequencyValue" Property="Foreground" Value="{DynamicResource GpuFrequencyBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:DeviceKind.UnknownGpu}">
                                    <Setter TargetName="DeviceBadge" Property="Background" Value="#FFF1C9" />
                                    <Setter TargetName="DeviceLabel" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="GpuKindLabel" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="GpuKindLabel" Property="Text" Value="{presentation:UiText '图形'}" />
                                    <Setter TargetName="UsageValue" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="TemperatureValue" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="PowerValue" Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                    <Setter TargetName="FrequencyValue" Property="Foreground" Value="{DynamicResource GpuFrequencyBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid x:Name="HomeQuickControlsPanel" Margin="-3,7,-3,0" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
