                                <RadioButton x:Name="DisplayColorCalibrationTab" Tag="0" Content="{presentation:UiText '色彩校正'}" GroupName="DisplaySettingsPage"
                                             IsChecked="{Binding IsDisplayColorCalibrationPage, Mode=OneWay}"
                                             Click="DisplaySettingsTab_Click">
                                    <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource DisplayTabRadioStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SupportsDisplayColorManagement}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                                </RadioButton>
                                <RadioButton x:Name="DisplayFeatureTab" Tag="1" Content="{presentation:UiText '显示功能'}" GroupName="DisplaySettingsPage"
                                             IsChecked="{Binding IsDisplayFeaturePage, Mode=OneWay}"
                                             Click="DisplaySettingsTab_Click">
                                    <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource DisplayTabRadioStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SupportsMiniLedLocalDimming}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                                </RadioButton>
                                <RadioButton x:Name="DisplayRefreshRateTab" Tag="2" Content="{presentation:UiText '刷新率'}" GroupName="DisplaySettingsPage"
                                             IsChecked="{Binding IsDisplayRefreshRatePage, Mode=OneWay}"
