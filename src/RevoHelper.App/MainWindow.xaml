                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="ExperimentalChargeDelayText" Text="{Binding UiCopy.ExperimentalChargeDelay}"
                                               Foreground="#D9363E" FontSize="{presentation:UiFont 8}" TextWrapping="Wrap" Margin="0,8,0,0" />
