                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Experiments.Charge.RecoveryPending}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style></Button.Style>
                                    </Button>
                                    <TextBlock x:Name="ExperimentalChargeStatusText" Text="{presentation:UiText Value={Binding Experiments.Charge.StatusText}}"
                                               Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 8}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="DisplayColorDrawerContent" Grid.Row="2" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
