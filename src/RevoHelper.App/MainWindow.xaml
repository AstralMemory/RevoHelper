                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{presentation:UiText '显示样式'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 10}" FontWeight="SemiBold" Margin="1,14,0,7" />
                            <Border Padding="13,11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{presentation:UiText '字号'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ComboBox x:Name="MonitorSizeSelector" Grid.Column="1" Height="30"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  ItemsSource="{Binding SizeOptions}" SelectedIndex="{Binding SelectedSizePreset, Mode=TwoWay}"
                                                  AutomationProperties.Name="{presentation:UiText '监控字号'}" ItemTemplate="{StaticResource LocalizedValueTemplate}" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{presentation:UiText '背景不透明度'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 10}" />
                                        <TextBlock x:Name="MonitorOpacityValue" Grid.Column="1" Text="{presentation:UiText Value={Binding BackgroundOpacityText}}"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 9.5}" />
                                    </Grid>
                                    <Slider x:Name="MonitorOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                                            SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" Margin="0,7,0,0"
                                            Value="{Binding BackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{presentation:UiText '小窗位置'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 10}" FontWeight="SemiBold" Margin="1,14,0,7" />
                            <Border Padding="10,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <Grid Margin="3,0,3,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="MonitorPositionLockText" Text="{presentation:UiText Value={Binding PositionLockText}}" Foreground="{DynamicResource TextBrush}"
                                                   FontSize="{presentation:UiFont 10.5}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <CheckBox x:Name="MonitorPositionLockToggle" Grid.Column="1"
                                                  IsChecked="{Binding IsPositionLocked, Mode=TwoWay}" Style="{StaticResource SettingsToggleStyle}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="{presentation:UiText '锁定监控小窗位置'}" />
                                    </Grid>
                                    <Grid x:Name="MonitorPositionPresets">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <RadioButton x:Name="MonitorTopLeftPosition" Grid.Row="0" Grid.Column="0" Content="{presentation:UiText '左上'}" Tag="TopLeft" GroupName="MonitorPosition"
                                                     Style="{StaticResource DisplayColorPresetRadioStyle}" Click="MonitorPosition_Click" IsChecked="{Binding IsTopLeft, Mode=OneWay}" />
                                        <RadioButton x:Name="MonitorTopCenterPosition" Grid.Row="0" Grid.Column="1" Content="{presentation:UiText '顶部居中'}" Tag="TopCenter" GroupName="MonitorPosition"
                                                     Style="{StaticResource DisplayColorPresetRadioStyle}" Click="MonitorPosition_Click" IsChecked="{Binding IsTopCenter, Mode=OneWay}" />
                                        <RadioButton x:Name="MonitorTopRightPosition" Grid.Row="0" Grid.Column="2" Content="{presentation:UiText '右上'}" Tag="TopRight" GroupName="MonitorPosition"
                                                     Style="{StaticResource DisplayColorPresetRadioStyle}" Click="MonitorPosition_Click" IsChecked="{Binding IsTopRight, Mode=OneWay}" />
                                        <RadioButton x:Name="MonitorBottomLeftPosition" Grid.Row="1" Grid.Column="0" Content="{presentation:UiText '左下'}" Tag="BottomLeft" GroupName="MonitorPosition"
                                                     Style="{StaticResource DisplayColorPresetRadioStyle}" Click="MonitorPosition_Click" IsChecked="{Binding IsBottomLeft, Mode=OneWay}" />
                                        <RadioButton x:Name="MonitorBottomCenterPosition" Grid.Row="1" Grid.Column="1" Content="{presentation:UiText '底部居中'}" Tag="BottomCenter" GroupName="MonitorPosition"
                                                     Style="{StaticResource DisplayColorPresetRadioStyle}" Click="MonitorPosition_Click" IsChecked="{Binding IsBottomCenter, Mode=OneWay}" />
                                        <RadioButton x:Name="MonitorBottomRightPosition" Grid.Row="1" Grid.Column="2" Content="{presentation:UiText '右下'}" Tag="BottomRight" GroupName="MonitorPosition"
                                                     Style="{StaticResource DisplayColorPresetRadioStyle}" Click="MonitorPosition_Click" IsChecked="{Binding IsBottomRight, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Text="{presentation:UiText '解锁后可直接拖动小窗。'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.8}" Margin="4,7,4,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{presentation:UiText 'FPS 来源'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 10}" FontWeight="SemiBold" Margin="1,14,0,7" />
                            <Border Padding="13,11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="MonitorAutomaticSource" Content="{presentation:UiText '自动跟随'}" GroupName="MonitorSourceMode" Height="30"
                                                     IsChecked="{Binding IsAutomatic, Mode=TwoWay}" Style="{StaticResource StrategyRadioStyle}" />
                                        <RadioButton x:Name="MonitorManualSource" Content="{presentation:UiText '手动指定'}" GroupName="MonitorSourceMode" Height="30"
                                                     IsChecked="{Binding IsManual, Mode=TwoWay}" Style="{StaticResource StrategyRadioStyle}" />
                                    </UniformGrid>
                                    <TextBlock Text="{presentation:UiText '自动跟随当前使用的程序；也可指定一个程序。'}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="{presentation:UiFont 8.8}" Margin="1,8,1,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{presentation:UiText '仅记录主动添加的程序及操作时间，保存在本机。'}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="{presentation:UiFont 8.8}" Margin="1,5,1,0" TextWrapping="Wrap" />
                                    <StackPanel x:Name="MonitorManualProgramsSection" Margin="0,10,0,0"
                                                Visibility="{Binding IsManual, Converter={StaticResource ModeVisibilityConverter}}">
                                        <UniformGrid Columns="2">
                                            <Button x:Name="AddMonitorProgramButton" Content="{presentation:UiText '添加程序…'}" Height="30" FontSize="{presentation:UiFont 9}" Margin="0,0,3,0"
                                                    Style="{StaticResource IconButtonStyle}" Click="AddMonitorProgram_Click" />
                                            <Button x:Name="RemoveMonitorProgramButton" Content="{presentation:UiText '移除记录'}" Height="30" FontSize="{presentation:UiFont 9}" Margin="3,0,0,0"
                                                    IsEnabled="{Binding HasSelectedProgram}" Style="{StaticResource IconButtonStyle}" Click="RemoveMonitorProgram_Click" />
                                        </UniformGrid>
                                        <ListBox x:Name="MonitorProgramsList" ItemsSource="{Binding Programs}"
                                                 SelectedItem="{Binding SelectedProgram, Mode=TwoWay}" MinHeight="105" MaxHeight="205" Margin="0,8,0,0"
                                                 Background="{DynamicResource NeutralF8FAFDBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" Padding="3"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Visibility="{Binding HasPrograms, Converter={StaticResource ModeVisibilityConverter}}">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="6,5" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="MonitorProgramItemSurface" CornerRadius="7"
                                                                        Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MonitorProgramItemSurface" Property="Background" Value="#F0F5FC" /></Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="MonitorProgramItemSurface" Property="Background" Value="#E7F3FF" />
                                                                        <Setter TargetName="MonitorProgramItemSurface" Property="BorderBrush" Value="#2185F4" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel ToolTip="{Binding ExecutablePath}">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 10}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{presentation:UiText Value={Binding AddedAtText, StringFormat=添加：{0}}}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.2}" Margin="0,3,0,0" />
                                                        <TextBlock Text="{presentation:UiText Value={Binding LastSelectedAtText, StringFormat=上次选择：{0}}}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.2}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="MonitorProgramsEmptyText" Text="{presentation:UiText '还没有程序。点击“添加程序”选择它的 EXE。'}"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 9}" Margin="2,10,2,0" TextWrapping="Wrap">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPrograms}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{presentation:UiText '只移除这里的记录，不会删除程序文件。'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.4}" Margin="2,8,2,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{presentation:UiText '没有可测画面时显示 FPS —，硬件信息仍会更新。'}" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="{presentation:UiFont 8.8}" Margin="2,8,2,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="PerformanceDrawerContent" Grid.Row="2" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock Text="{presentation:UiText '调整后自动应用'}"
                                       ToolTip="{presentation:UiText '连续拖动只提交最后一次结果；操作失败会保留提示。'}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 9.3}" TextWrapping="Wrap" />
                            <Border Margin="0,10,0,0" Padding="11,9" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11">
                                <Expander x:Name="PerformanceReadbackDetails" Header="{presentation:UiText '状态详情'}" IsExpanded="False"
                                          Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 9.5}">
                                    <StackPanel>
                                    <TextBlock Text="{presentation:UiText Value={Binding OemConnectionStatusText}}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="{presentation:UiFont 8.5}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                    <TextBlock Text="{presentation:UiText Value={Binding PerformanceReadbackText}}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="{presentation:UiFont 8.5}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="12,10" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{presentation:UiText 'Windows 处理器 Boost 策略'}" Foreground="{DynamicResource TextBrush}"
                                                   FontSize="{presentation:UiFont 11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Width="13" Height="13" Margin="5,0,0,0" CornerRadius="6.5"
                                                BorderBrush="{DynamicResource Neutral93A0B2Brush}" BorderThickness="0.8" Background="{DynamicResource SurfaceBrush}"
                                                Cursor="Help" VerticalAlignment="Center"
                                                ToolTip="{presentation:UiText 'Disabled 会关闭睿频；其余选项决定 Windows 请求睿频的积极程度。写入后 RevoHelper 会延迟复查，以识别被其他程序覆盖的情况。'}">
                                            <TextBlock Text="?" Foreground="{DynamicResource Neutral718095Brush}" FontSize="{presentation:UiFont 8}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <Border Margin="0,8,0,0" Height="34" CornerRadius="9"
                                            BorderBrush="{Binding PerformanceAccentColor}" BorderThickness="1.2"
                                            Background="{DynamicResource NeutralF8FAFDBrush}" ClipToBounds="True">
                                        <ComboBox x:Name="ProcessorBoostModeSelector"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  ItemsSource="{Binding ProcessorBoostModes}"
                                                  ItemTemplate="{StaticResource LocalizedLabelTemplate}" SelectedValuePath="Mode"
                                                  SelectedValue="{Binding SelectedProcessorBoostMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Padding="10,0" FontSize="{presentation:UiFont 10}" FontWeight="SemiBold"
                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                  Background="Transparent" BorderThickness="0"
                                                  SelectionChanged="PerformanceBoost_SelectionChanged" />
                                    </Border>
                                </StackPanel>
                            </Border>

                             <StackPanel x:Name="CustomPowerLimitEditorPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanEditPowerLimits}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                 </StackPanel.Style>
                            <TextBlock x:Name="OemPresetPowerLimitWarning"
                                       Text="{presentation:UiText '可能无法调节超过机械革命官方预设的功耗 PL 值。例如平衡模式默认最高 85 W，该限制无法被突破，但可以向下调整。若想尝试自定义调整，请使用狂暴模式，或在自定义模式方案中细调。'}"
                                       Foreground="#D9363E" FontSize="{presentation:UiFont 8.6}" TextWrapping="Wrap"
                                       Margin="2,9,2,0" />
                            <Border Margin="0,9,0,0" Padding="12,10" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{presentation:UiText 'PL1 · 长时功耗限制'}" Foreground="{DynamicResource TextBrush}"
                                                       FontSize="{presentation:UiFont 10.5}" FontWeight="SemiBold" />
                                            <TextBlock Text="{presentation:UiText '持续负载的主要功耗上限'}" Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="{presentation:UiFont 8.2}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBox x:Name="PerformancePl1Editor" Grid.Column="1"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SelectedPl1Watts, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanEditPowerLimits}"
                                                 Height="28" Padding="5,0" FontSize="{presentation:UiFont 10.5}" TextAlignment="Right"
                                                 VerticalContentAlignment="Center" BorderBrush="{Binding PerformanceAccentColor}"
                                                 LostKeyboardFocus="PerformanceEditor_LostKeyboardFocus"
                                                 KeyDown="PerformanceEditor_KeyDown" />
                                    </Grid>
                                    <Slider x:Name="PerformancePl1Slider" Minimum="5" Maximum="250" Margin="0,8,0,0"
                                            SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding CanEditPowerLimits}"
                                            ToolTip="{presentation:UiText Value={Binding OemPowerLimitAvailabilityReason}}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Value="{Binding SelectedPl1Watts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ValueChanged="PerformanceSlider_ValueChanged"
                                            Foreground="{Binding PerformanceAccentColor}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="12,10" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{presentation:UiText 'PL2 · 短时功耗限制'}" Foreground="{DynamicResource TextBrush}"
                                                       FontSize="{presentation:UiFont 10.5}" FontWeight="SemiBold" />
                                            <TextBlock Text="{presentation:UiText '短时睿频与突发负载的功耗上限'}" Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="{presentation:UiFont 8.2}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBox x:Name="PerformancePl2Editor" Grid.Column="1"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SelectedPl2Watts, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanEditPowerLimits}"
                                                 Height="28" Padding="5,0" FontSize="{presentation:UiFont 10.5}" TextAlignment="Right"
                                                 VerticalContentAlignment="Center" BorderBrush="{Binding PerformanceAccentColor}"
                                                 LostKeyboardFocus="PerformanceEditor_LostKeyboardFocus"
                                                 KeyDown="PerformanceEditor_KeyDown" />
                                    </Grid>
                                    <Slider x:Name="PerformancePl2Slider" Minimum="5" Maximum="250" Margin="0,8,0,0"
                                            SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding CanEditPowerLimits}"
                                            ToolTip="{presentation:UiText Value={Binding OemPowerLimitAvailabilityReason}}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Value="{Binding SelectedPl2Watts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ValueChanged="PerformanceSlider_ValueChanged"
                                            Foreground="{Binding PerformanceAccentColor}" />
                                </StackPanel>
                            </Border>

                            <Border presentation:ThemeScope.AccentSurface="True" x:Name="PerformanceValidationNotice" Margin="0,9,0,0" Padding="10,8"
                                    Background="#FFF2F2"
                                    BorderBrush="#D9363E" BorderThickness="1" CornerRadius="9">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPerformanceDraftValid}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{presentation:UiText Value={Binding PerformanceValidationText}}"
                                           Foreground="#D9363E" FontSize="{presentation:UiFont 8.8}" TextWrapping="Wrap" />
                            </Border>
                            </StackPanel>

                            <StackPanel x:Name="CustomAdvancedPerformancePanel" Margin="0,10,0,0">
                                <TextBlock Text="{presentation:UiText Value={Binding AdvancedPerformanceTitle}}" Foreground="{DynamicResource TextBrush}"
                                           FontSize="{presentation:UiFont 11}" FontWeight="Bold" ToolTip="{presentation:UiText Value={Binding AdvancedPerformanceDescription}}" />
                                <Border presentation:ThemeScope.AccentSurface="True" Margin="0,5,0,0" Padding="8,5" Background="#FFF8E8" BorderBrush="#E7B248" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="{presentation:UiText Value={Binding CustomPerformanceStatusText}}" Foreground="#8A6500" FontSize="{presentation:UiFont 8.2}"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                </Border>

                                <Border x:Name="PresetAdvancedPerformanceLockNotice" Padding="0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomProfileSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{presentation:UiText '仅在自定义模式可调整。'}"
                                               Foreground="{DynamicResource Neutral7B8798Brush}" FontSize="{presentation:UiFont 8.2}" TextWrapping="Wrap" />
                                </Border>

                                <Border x:Name="CustomCpuAdvancedCard" Margin="0,8,0,0" Padding="12,9" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11"
                                        IsEnabled="{Binding CanEditAdvancedPerformance}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsCustomProfileSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{presentation:UiText 'CPU 温度墙'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 10.5}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding CustomCpuTemperatureWallEnabled, Mode=TwoWay}"
                                                      Tag="CpuTemperatureWallEnabled"
                                                      Style="{StaticResource SettingsToggleStyle}" HorizontalAlignment="Right"
                                                      Click="CustomPerformanceToggle_Click" />
                                        </Grid>
                                        <Grid IsEnabled="{Binding CustomCpuTemperatureWallEnabled}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                            <Slider Minimum="70" Maximum="105" TickFrequency="5" SmallChange="5" LargeChange="5" IsSnapToTickEnabled="True"
                                                    Tag="CpuTemperatureWallC"
                                                    Value="{Binding CustomCpuTemperatureWallC, Mode=TwoWay}"
                                                    ValueChanged="CustomPerformanceSlider_ValueChanged" />
                                            <TextBlock Grid.Column="1" Text="{presentation:UiText Value={Binding CustomCpuTemperatureWallC, StringFormat={}{0}°C}}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Separator Margin="0,8" Background="{DynamicResource NeutralE3E9F1Brush}" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{presentation:UiText '瞬时高负载功耗墙 (PL4)'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 10}" FontWeight="SemiBold" /><Slider x:Name="CustomCpuPl4Slider" Tag="CpuBurstPowerLimitWatts" Minimum="5" Maximum="400" TickFrequency="5" SmallChange="5" LargeChange="5" IsSnapToTickEnabled="True" Value="{Binding CustomCpuBurstPowerLimitWatts, Mode=TwoWay}" ValueChanged="CustomPerformanceSlider_ValueChanged" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{presentation:UiText Value={Binding CustomCpuBurstPowerLimitWatts, StringFormat={}{0} W}}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <Separator Margin="0,8" Background="{DynamicResource NeutralE3E9F1Brush}" />
                                        <Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{presentation:UiText 'CPU 高级性能菜单'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 10}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding CustomCpuAdvancedMenuEnabled, Mode=TwoWay}"
                                                      Tag="CpuAdvancedMenuEnabled"
                                                      Style="{StaticResource SettingsToggleStyle}" HorizontalAlignment="Right"
                                                      Click="CustomPerformanceToggle_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="CustomGpuAdvancedCard" Margin="0,8,0,0" Padding="12,9" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11"
                                        IsEnabled="{Binding CanEditAdvancedPerformance}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsCustomProfileSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{presentation:UiText 'GPU 超性能开关'}" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 10.5}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding CustomOverclockingEnabled, Mode=TwoWay}"
                                                      Tag="GpuOverclockingEnabled"
                                                      Style="{StaticResource SettingsToggleStyle}" HorizontalAlignment="Right"
                                                      Click="CustomPerformanceToggle_Click" />
                                        </Grid>
                                        <TextBlock Text="{presentation:UiText '开启后可调整 TGP、Dynamic Boost 与频率偏移；关闭时统一锁定。'}"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.2}" TextWrapping="Wrap" />
                                        <StackPanel x:Name="GpuManualPowerPanel" Style="{StaticResource GpuBranchPanelStyle}" IsEnabled="{Binding CanEditGpuPower}">
                                            <Separator Margin="0,6" Background="{DynamicResource NeutralE3E9F1Brush}" />
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Configurable TGP Target" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 9.5}" /><Slider x:Name="GpuTgpSlider" Tag="GpuTgpWatts" Minimum="{Binding CustomGpuTgpMinimum}" Maximum="{Binding CustomGpuTgpMaximum}" TickFrequency="5" SmallChange="5" LargeChange="5" IsSnapToTickEnabled="True" Value="{Binding CustomGpuTgpWatts, Mode=TwoWay}" ValueChanged="CustomPerformanceSlider_ValueChanged" /></StackPanel><TextBlock Grid.Column="1" Text="{presentation:UiText Value={Binding CustomGpuTgpWatts, StringFormat={}{0} W}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid>
                                            <Grid Height="38" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions><TextBlock Text="Dynamic Boost" Foreground="{DynamicResource TextBrush}" FontSize="{presentation:UiFont 9.5}" VerticalAlignment="Center" /><CheckBox Grid.Column="1" Tag="GpuDynamicBoostEnabled" IsChecked="{Binding CustomGpuDynamicBoostEnabled, Mode=TwoWay}" Style="{StaticResource SettingsToggleStyle}" HorizontalAlignment="Right" Click="CustomPerformanceToggle_Click" /></Grid>
                                            <Grid IsEnabled="{Binding CustomGpuDynamicBoostEnabled}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><Slider x:Name="GpuDynamicBoostSlider" Tag="GpuDynamicBoostWatts" Minimum="{Binding CustomGpuDynamicBoostMinimum}" Maximum="{Binding CustomGpuDynamicBoostMaximum}" TickFrequency="5" SmallChange="5" LargeChange="5" IsSnapToTickEnabled="True" Value="{Binding CustomGpuDynamicBoostWatts, Mode=TwoWay}" ValueChanged="CustomPerformanceSlider_ValueChanged" /><TextBlock Grid.Column="1" Text="{presentation:UiText Value={Binding CustomGpuDynamicBoostWatts, StringFormat={}{0} W}}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                                            <TextBlock Text="{presentation:UiText '控制显卡可用的额外功耗，不代表实际耗电。'}"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.2}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Separator Margin="0,8" Background="{DynamicResource NeutralE3E9F1Brush}" />
                                        <StackPanel x:Name="GpuClockOffsetsPanel" Style="{StaticResource GpuBranchPanelStyle}" IsEnabled="{Binding CanEditGpuClockOffsets}">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{presentation:UiText '核心频率偏移'}" FontSize="{presentation:UiFont 9.5}" /><Slider x:Name="GpuCoreOffsetSlider" Tag="GpuCoreOffsetMhz" Minimum="{Binding CustomGpuCoreOffsetMinimum}" Maximum="{Binding CustomGpuCoreOffsetMaximum}" TickFrequency="20" SmallChange="20" LargeChange="20" IsSnapToTickEnabled="True" Value="{Binding CustomGpuCoreOffsetMhz, Mode=TwoWay}" ValueChanged="GpuClockOffsetSlider_ValueChanged" /></StackPanel><TextBlock Grid.Column="1" Text="{presentation:UiText Value={Binding CustomGpuCoreOffsetMhz, StringFormat={}{0} MHz}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid>
                                                <TextBlock x:Name="GpuCoreOffsetWarning" Text="{presentation:UiText '核心频率不建议超过300MHz'}" Foreground="#D9363E" FontSize="{presentation:UiFont 9}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{presentation:UiText '显存频率偏移'}" FontSize="{presentation:UiFont 9.5}" /><Slider x:Name="GpuMemoryOffsetSlider" Tag="GpuMemoryOffsetMhz" Minimum="{Binding CustomGpuMemoryOffsetMinimum}" Maximum="{Binding CustomGpuMemoryOffsetMaximum}" TickFrequency="20" SmallChange="20" LargeChange="20" IsSnapToTickEnabled="True" Value="{Binding CustomGpuMemoryOffsetMhz, Mode=TwoWay}" ValueChanged="GpuClockOffsetSlider_ValueChanged" /></StackPanel><TextBlock Grid.Column="1" Text="{presentation:UiText Value={Binding CustomGpuMemoryOffsetMhz, StringFormat={}{0} MHz}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid>
                                                <TextBlock x:Name="GpuMemoryOffsetWarning" Text="{presentation:UiText '显存不建议超过1000MHz'}" Foreground="#D9363E" FontSize="{presentation:UiFont 9}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{presentation:UiText Value={Binding GpuOffsetRangeText}}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="{presentation:UiFont 8.2}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border presentation:ThemeScope.AccentSurface="True" x:Name="FirmwareManagedPowerLimitNotice"
                                    Margin="0,9,0,0" Padding="11,10" Background="#FFF8E8"
                                    BorderBrush="#E7B248" BorderThickness="1" CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanEditPowerLimits}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{presentation:UiText '功耗由官方预设管理'}"
                                               Foreground="#9A6500" FontSize="{presentation:UiFont 10.5}" FontWeight="SemiBold" />
                                    <TextBlock Text="{presentation:UiText Value={Binding OemPowerLimitAvailabilityReason}}"
                                               Foreground="#8A6A2B" FontSize="{presentation:UiFont 8.5}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,9,0,0" Padding="12,10" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{presentation:UiText 'Windows 通用最高处理器频率'}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="{presentation:UiFont 11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Width="13" Height="13" Margin="5,0,0,0" CornerRadius="6.5"
                                                        BorderBrush="{DynamicResource Neutral93A0B2Brush}" BorderThickness="0.8" Background="{DynamicResource SurfaceBrush}"
                                                        Cursor="Help" VerticalAlignment="Center"
                                                        ToolTip="{presentation:UiText '不区分 P / E 核；同时写入当前电源方案 AC / DC 的处理器 Class 0、Class 1 与 Class 2。仅在本次 RevoHelper 会话持有，退出或异常恢复时还原；部分固件仍可能忽略。'}">
                                                    <TextBlock Text="?" Foreground="{DynamicResource Neutral718095Brush}" FontSize="{presentation:UiFont 8}" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="ProcessorFrequencyDelayWarning"
                                                       Text="{presentation:UiText '仅本次会话持有；退出自动恢复。生效可能延迟约 5–10 秒'}"
                                                       Foreground="#D9363E" FontSize="{presentation:UiFont 8}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                  IsChecked="{Binding IsProcessorFrequencyLimitEnabled, Mode=TwoWay}"
                                                  Click="PerformanceToggle_Click" />
                                    </Grid>
                                    <Grid Margin="0,9,0,0" IsEnabled="{Binding IsProcessorFrequencyLimitEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="ProcessorFrequencyLimitSlider"
                                                Minimum="1000" Maximum="6000" TickFrequency="100"
                                                IsSnapToTickEnabled="True" Margin="0,0,9,0"
                                                Value="{Binding SelectedMaximumProcessorFrequencyMhz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ValueChanged="PerformanceSlider_ValueChanged" />
                                        <TextBox x:Name="ProcessorFrequencyLimitEditor" Grid.Column="1" Height="27" Padding="4,0" TextAlignment="Right"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 VerticalContentAlignment="Center" FontSize="{presentation:UiFont 9.5}"
                                                 BorderBrush="{Binding PerformanceAccentColor}"
                                                 Text="{Binding SelectedMaximumProcessorFrequencyMhz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 LostKeyboardFocus="PerformanceEditor_LostKeyboardFocus"
                                                 KeyDown="PerformanceEditor_KeyDown" />
                                        <TextBlock Grid.Column="2" Text="MHz" Margin="4,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="{presentation:UiFont 8.3}" />
                                    </Grid>
                                    <TextBlock Text="{presentation:UiText Value={Binding ProcessorFrequencyLimitStatusText}}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.2}"
                                               TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <Button Content="{presentation:UiText '恢复 OEM 读取值并立即应用'}" Height="30" Margin="2,10,2,0" FontSize="{presentation:UiFont 8.5}"
                                    Style="{StaticResource IconButtonStyle}" Click="ResetPerformanceDraft_Click" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="GpuOutputDrawerContent" Grid.Row="2" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,3,0">
                            <Border Padding="11,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}"
                                    BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="{presentation:UiText Value={Binding GpuOutputStatusText}}" Foreground="{DynamicResource TextBrush}"
                                               FontSize="{presentation:UiFont 10}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{presentation:UiText '切换后需重启电脑。'}"
                                               ToolTip="{presentation:UiText '与运行中关闭独显的“核显省电”不同。'}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.4}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <RadioButton x:Name="GpuHybridRadio" Tag="Hybrid" GroupName="GpuOutputMode"
                                         IsEnabled="{Binding SupportsHybridGpuMode}" Checked="GpuOutputMode_Checked"
                                         Margin="0,10,0,0" Padding="13,11" Background="{DynamicResource SurfaceBrush}"
                                         BorderBrush="{DynamicResource NeutralCCD6E4Brush}" Style="{StaticResource GpuOutputRadioStyle}">
                                <StackPanel>
                                    <TextBlock Text="{presentation:UiText '混合输出'}" FontSize="{presentation:UiFont 12}" FontWeight="SemiBold" />
                                    <TextBlock Text="{presentation:UiText '日常推荐 · 核显负责桌面，独显按需工作'}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.5}" Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="GpuDiscreteRadio" Tag="Discrete" GroupName="GpuOutputMode"
                                         IsEnabled="{Binding SupportsDiscreteGpuMode}" Checked="GpuOutputMode_Checked"
                                         Margin="0,8,0,0" Padding="13,11" Background="{DynamicResource SurfaceBrush}"
                                         BorderBrush="{DynamicResource NeutralCCD6E4Brush}" Style="{StaticResource GpuOutputRadioStyle}">
                                <StackPanel>
                                    <TextBlock Text="{presentation:UiText '独显直连'}" FontSize="{presentation:UiFont 12}" FontWeight="SemiBold" />
                                    <TextBlock Text="{presentation:UiText '内屏由独显直接输出 · 优先游戏性能'}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.5}" Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="GpuIntegratedRadio" Tag="Integrated" GroupName="GpuOutputMode"
                                         IsEnabled="{Binding SupportsIntegratedGpuMode}" Checked="GpuOutputMode_Checked"
                                         Margin="0,8,0,0" Padding="13,11" Background="{DynamicResource SurfaceBrush}"
                                         BorderBrush="{DynamicResource NeutralCCD6E4Brush}" Style="{StaticResource GpuOutputRadioStyle}">
                                <StackPanel>
                                    <TextBlock Text="{presentation:UiText '纯核显模式'}" FontSize="{presentation:UiFont 12}" FontWeight="SemiBold" />
                                    <TextBlock Text="{presentation:UiText '关闭独显显示通路 · 仅在机型能力确认后开放'}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.5}" Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <Border presentation:ThemeScope.AccentSurface="True" Margin="0,10,0,0" Padding="11,9" Background="#FFF7E8"
                                    BorderBrush="#E5B95C" BorderThickness="1" CornerRadius="10">
                                <TextBlock x:Name="GpuOutputRestartWarning" Text="{presentation:UiText '切换显卡输出后需重启电脑。请先保存工作；RevoHelper 不会自动重启。'}"
                                           Foreground="#D9363E" FontSize="{presentation:UiFont 8.8}" TextWrapping="Wrap" />
                            </Border>
                            <Button x:Name="ApplyGpuOutputModeButton" Content="{presentation:UiText '应用并回读'}"
                                    Height="34" Margin="0,11,0,0" FontSize="{presentation:UiFont 10}"
                                    IsEnabled="{Binding IsGpuOutputApplyEnabled}"
                                    Style="{StaticResource IconButtonStyle}" Click="ApplyGpuOutputMode_Click" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="LightingDrawerContent" Grid.Row="2" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LightingControlsStack" Margin="7,6,7,12">
                            <TextBlock x:Name="LightingBuildLabel" Text="{presentation:UiText '分区即时编辑'}" Margin="2,0,0,6"
                                       Foreground="{DynamicResource Neutral66758CBrush}" FontSize="{presentation:UiFont 8}" />
                            <Border presentation:ThemeScope.AccentSurface="True" Padding="11,9" Background="#EEF8FF" BorderBrush="#7CC5F4" BorderThickness="1" CornerRadius="10">
                                <TextBlock Text="{presentation:UiText Value={Binding LightingStatusText}}" Foreground="#176B9B" FontSize="{presentation:UiFont 8.4}"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LightingKeyboardTab" Grid.Column="0" Tag="Keyboard" Content="{presentation:UiText '键盘'}" Margin="0,0,3,0"
                                        Height="34" FontSize="{presentation:UiFont 9}" Style="{StaticResource IconButtonStyle}" Click="LightingZoneTab_Click" />
                                <Button x:Name="LightingCoastTab" Grid.Column="1" Tag="CoastLightbar" Content="{presentation:UiText '灯带'}" Margin="1,0,2,0"
                                        Height="34" FontSize="{presentation:UiFont 9}" Click="LightingZoneTab_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsCoastLightingZoneAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button x:Name="LightingLogoTab" Grid.Column="2" Tag="Logo" Content="LOGO" Margin="2,0,1,0"
                                        Height="34" FontSize="{presentation:UiFont 9}" Click="LightingZoneTab_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsLogoLightingZoneAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button x:Name="LightingWaterTab" Grid.Column="3" Tag="LiquidCooler" Content="{presentation:UiText '水冷灯'}" Margin="3,0,0,0"
                                        Height="34" FontSize="{presentation:UiFont 9}" Click="LightingZoneTab_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsWaterLightingZoneAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </Grid>

                            <StackPanel x:Name="KeyboardLightingProfilesSection">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardLightingZoneSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{presentation:UiText '键盘灯光方案'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8.8}" FontWeight="SemiBold" Margin="2,12,0,6" />
                                <Button presentation:ThemeScope.AccentSurface="True" x:Name="OemDefaultLightingButton" Height="42" Padding="12,0" HorizontalContentAlignment="Left"
                                        Background="#FFF7E8" BorderBrush="#E9BD61" Style="{StaticResource IconButtonStyle}"
                                        Click="OemDefaultLighting_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="◉" Foreground="#D78A00" FontSize="{presentation:UiFont 15}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                        <StackPanel><TextBlock Text="{presentation:UiText '机器最初始默认背光'}" FontSize="{presentation:UiFont 9.5}" FontWeight="SemiBold" /><TextBlock Text="{presentation:UiText '恢复官方彩色静态键盘背光'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 7.6}" /></StackPanel>
                                    </StackPanel>
                                </Button>
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <Button presentation:ThemeScope.AccentSurface="True" Tag="revo-flow" Height="48" Margin="0,0,3,3" Background="#F0EBFF" BorderBrush="#B8A3F2" Style="{StaticResource IconButtonStyle}" Click="LightingPreset_Click"><StackPanel><TextBlock Text="{presentation:UiText '耀世流光'}" FontWeight="SemiBold" FontSize="{presentation:UiFont 9.5}" /><TextBlock Text="{presentation:UiText '键盘彩虹 · 平滑流动'}" FontSize="{presentation:UiFont 7.2}" Foreground="#7559B8" /></StackPanel></Button>
                                    <Button presentation:ThemeScope.AccentSurface="True" Tag="ice-breath" Height="48" Margin="3,0,0,3" Background="#EAF8FF" BorderBrush="#88C9EC" Style="{StaticResource IconButtonStyle}" Click="LightingPreset_Click"><StackPanel><TextBlock Text="{presentation:UiText '冰海呼吸'}" FontWeight="SemiBold" FontSize="{presentation:UiFont 9.5}" /><TextBlock Text="{presentation:UiText '键盘青蓝呼吸 · 低干扰'}" FontSize="{presentation:UiFont 7.2}" Foreground="#297DAA" /></StackPanel></Button>
                                    <Button presentation:ThemeScope.AccentSurface="True" Tag="quiet-night" Height="48" Margin="0,3,3,0" Background="#EEF1F8" BorderBrush="#B9C4D7" Style="{StaticResource IconButtonStyle}" Click="LightingPreset_Click"><StackPanel><TextBlock Text="{presentation:UiText '静夜微光'}" FontWeight="SemiBold" FontSize="{presentation:UiFont 9.5}" /><TextBlock Text="{presentation:UiText '键盘低亮静态 · 深蓝'}" FontSize="{presentation:UiFont 7.2}" Foreground="{DynamicResource Neutral52647CBrush}" /></StackPanel></Button>
                                    <Button presentation:ThemeScope.AccentSurface="True" x:Name="ApplyImportedLightingButton" Height="48" Margin="3,3,0,0" Background="#EEFAF3" BorderBrush="#94D2AE" Style="{StaticResource IconButtonStyle}" Click="ApplyImportedLighting_Click"><StackPanel><TextBlock Text="{presentation:UiText '应用已载入方案'}" FontWeight="SemiBold" FontSize="{presentation:UiFont 9.2}" /><TextBlock Text="{presentation:UiText '只改变键盘灯光'}" FontSize="{presentation:UiFont 7.2}" Foreground="#34815A" /></StackPanel></Button>
                                </UniformGrid>
                            </StackPanel>

                            <Border Margin="0,10,0,0" Padding="12,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource NeutralD7E0EBBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{presentation:UiText Value={Binding SelectedLightingZoneLabel}}" FontSize="{presentation:UiFont 11}" FontWeight="SemiBold" ToolTip="{presentation:UiText '分别设置每个区域的灯光。'}" /></StackPanel>
                                        <CheckBox x:Name="LightingZonePowerToggle" Grid.Column="1" IsChecked="{Binding IsSelectedLightingZoneEnabled, Mode=TwoWay}" IsEnabled="{Binding CanToggleSelectedLightingZonePower}" Style="{StaticResource SettingsToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="LightingZonePower_Click" />
                                    </Grid>
                                    <TextBlock Text="{presentation:UiText '灯效'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8}" Margin="0,10,0,4" />
                                    <ComboBox x:Name="LightingEffectCombo" Height="34" Padding="8,0" ItemsSource="{Binding LightingEffectOptions}"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              ItemTemplate="{StaticResource LocalizedLabelTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedLightingEffect, Mode=TwoWay}"
                                              SelectionChanged="LightingEffect_SelectionChanged" />
                                    <StackPanel x:Name="LightingColorEditor">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanEditLightingColor}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{presentation:UiText '颜色'}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 8}" Margin="0,9,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{Binding LightingColorHex}" BorderBrush="{DynamicResource NeutralCBD7E6Brush}" BorderThickness="1" />
                                            <TextBox x:Name="LightingColorHexBox" Grid.Column="1" Height="32" Margin="6,0,0,0" Padding="9,5" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding LightingColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="{presentation:UiFont 9.5}" LostKeyboardFocus="LightingColorHexBox_LostKeyboardFocus" KeyDown="LightingColorHexBox_KeyDown" />
                                        </Grid>
                                        <UniformGrid Columns="7" Margin="0,7,0,0">
                                            <Button Tag="#FF0000" Background="#FF0000" Height="26" Margin="2" Style="{StaticResource LightingColorChipStyle}" ToolTip="{presentation:UiText '红色 #FF0000'}" AutomationProperties.Name="{presentation:UiText '红色 #FF0000'}" Click="LightingColorChip_Click" />
                                            <Button Tag="#FF7000" Background="#FF7000" Height="26" Margin="2" Style="{StaticResource LightingColorChipStyle}" ToolTip="{presentation:UiText '橙色 #FF7000'}" AutomationProperties.Name="{presentation:UiText '橙色 #FF7000'}" Click="LightingColorChip_Click" />
                                            <Button Tag="#FFFF00" Background="#FFFF00" Height="26" Margin="2" Style="{StaticResource LightingColorChipStyle}" ToolTip="{presentation:UiText '黄色 #FFFF00'}" AutomationProperties.Name="{presentation:UiText '黄色 #FFFF00'}" Click="LightingColorChip_Click" />
                                            <Button Tag="#24D66A" Background="#24D66A" Height="26" Margin="2" Style="{StaticResource LightingColorChipStyle}" ToolTip="{presentation:UiText '绿色 #24D66A'}" AutomationProperties.Name="{presentation:UiText '绿色 #24D66A'}" Click="LightingColorChip_Click" />
                                            <Button Tag="#00B0FF" Background="#00B0FF" Height="26" Margin="2" Style="{StaticResource LightingColorChipStyle}" ToolTip="{presentation:UiText '青蓝色 #00B0FF'}" AutomationProperties.Name="{presentation:UiText '青蓝色 #00B0FF'}" Click="LightingColorChip_Click" />
                                            <Button Tag="#5267FF" Background="#5267FF" Height="26" Margin="2" Style="{StaticResource LightingColorChipStyle}" ToolTip="{presentation:UiText '蓝色 #5267FF'}" AutomationProperties.Name="{presentation:UiText '蓝色 #5267FF'}" Click="LightingColorChip_Click" />
                                            <Button Tag="#9A45FF" Background="#9A45FF" Height="26" Margin="2" Style="{StaticResource LightingColorChipStyle}" ToolTip="{presentation:UiText '紫色 #9A45FF'}" AutomationProperties.Name="{presentation:UiText '紫色 #9A45FF'}" Click="LightingColorChip_Click" />
                                        </UniformGrid>
                                    </StackPanel>
