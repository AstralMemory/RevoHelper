                                        CornerRadius="5.5" BorderBrush="{DynamicResource Neutral93A0B2Brush}" BorderThickness="0.8"
                                        Background="{DynamicResource NeutralFFFFFFBrush}" Cursor="Help" VerticalAlignment="Center"
                                        ToolTipService.InitialShowDelay="180" ToolTipService.ShowDuration="20000">
                                    <Border.ToolTip>
                                        <ToolTip MaxWidth="330" Placement="Mouse">
                                            <TextBlock x:Name="RadarHelpTooltipText" Width="300" TextWrapping="Wrap"
                                                       FontSize="{presentation:UiFont 11}" LineHeight="17"
                                                        Text="{presentation:UiText '仅供大致参考。用户可在风扇曲线上微调想要的噪音表现，改进温度控制。笔记本的低噪音、高性能与低温度几乎构成不可能三角。使用水冷（设备支持时）、空调冷气环境或风压式散热器等辅助散热手段，通常可以提升整机解热能力，并同时改善噪音控制、性能释放与温度表现。'}" />
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Text="?" Foreground="{DynamicResource Neutral718095Brush}" FontSize="{presentation:UiFont 7}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <Button x:Name="MoreProfilesButton" Content="{Binding UiCopy.MoreProfilesTitle}" Width="63" Height="24"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,32,0,0"
                                    FontSize="{presentation:UiFont 8.5}" Style="{StaticResource IconButtonStyle}" Click="MoreProfiles_Click"
                                    ToolTip="{Binding UiCopy.MoreProfilesHint}" Panel.ZIndex="1" />
                            <Canvas x:Name="RadarCanvas" Width="150" Height="104" Margin="34,2,0,0" VerticalAlignment="Top">
                                <Canvas>
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.86" ScaleY="0.86" CenterX="75" CenterY="64" />
                                            <TranslateTransform Y="-2" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                <Polygon Points="75,10 20,92 130,92"
                                         Stroke="{DynamicResource Neutral7D8DA5Brush}" StrokeThickness="2" Fill="Transparent" />
                                <Polygon x:Name="TradeoffPolygon" Stroke="#2185F4" StrokeThickness="1.6"
                                         Fill="#91C5FF" Opacity="0.75" />
                                <Polygon x:Name="RadarGuideMiddle" Points="75,28 38,83 112,83"
                                         Stroke="{DynamicResource Neutral91A0B5Brush}" StrokeThickness="0.9" StrokeDashArray="3 3"
                                         Opacity="0.68" Fill="Transparent" />
                                <Polygon x:Name="RadarGuideInner" Points="75,46 56,74 94,74"
                                         Stroke="{DynamicResource Neutral91A0B5Brush}" StrokeThickness="0.9" StrokeDashArray="3 3"
                                         Opacity="0.68" Fill="Transparent" />
                                <Line x:Name="RadarAxisNoise" X1="75" Y1="64" X2="75" Y2="10"
