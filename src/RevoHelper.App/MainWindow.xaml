                                           Foreground="{Binding PerformanceAccentColor}" FontSize="{presentation:UiFont 10}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding MachineName}" Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 10}" />
                    </StackPanel>
                    <Button x:Name="MainCloseButton" Grid.Column="2" Width="31" Height="31"
                            Style="{StaticResource IconButtonStyle}" Click="Close_Click" ToolTip="{presentation:UiText '关闭窗口'}">
