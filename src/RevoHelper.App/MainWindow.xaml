                                <Line x:Name="RadarAxisPerformance" X1="75" Y1="64" X2="20" Y2="92"
                                      Stroke="{DynamicResource Neutral8190A4Brush}" StrokeThickness="0.9" StrokeDashArray="2 3" Opacity="0.62" />
                                <Line x:Name="RadarAxisTemperature" X1="75" Y1="64" X2="130" Y2="92"
                                      Stroke="{DynamicResource Neutral8190A4Brush}" StrokeThickness="0.9" StrokeDashArray="2 3" Opacity="0.62" />
                                <Ellipse x:Name="TradeoffCenter" Width="8" Height="8"
                                         Canvas.Left="71" Canvas.Top="60" Fill="#2185F4" />
                                </Canvas>
                                <TextBlock Text="{Binding UiCopy.NoiseLabel}" Canvas.Left="47" Canvas.Top="1" Width="56" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 9.3}" />
                                <TextBlock x:Name="RadarPerformanceLabel" Text="{Binding UiCopy.PerformanceLabel}" Canvas.Left="0" Canvas.Top="88.5" Width="56" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 9.3}" />
                                <TextBlock x:Name="RadarTemperatureLabel" Text="{Binding UiCopy.TemperatureLabel}" Canvas.Left="94" Canvas.Top="88.5" Width="56" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="{presentation:UiFont 9.3}" />
                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource LineBrush}" />

