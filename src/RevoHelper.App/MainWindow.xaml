                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border presentation:ThemeScope.AccentSurface="True" x:Name="LightingQuickIconTile" Style="{StaticResource QuickActionIconTileStyle}" Background="#F2ECFF">
                                        <Viewbox Width="12" Height="12"><Path Data="M8,1 L9.5,6.5 L15,8 L9.5,9.5 L8,15 L6.5,9.5 L1,8 L6.5,6.5 Z"
